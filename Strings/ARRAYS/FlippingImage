class FlippingImage {
    public int[][] flipAndInvertImage(int[][] image) {
        int row=image.length; 
        int col=image[0].length;
        int[][] t=new int[row][col];
        for(int i=0;i<row;i++){
            int c=0;
            for(int j=col-1;j>=0;j--){
                t[i][c++]=1-image[i][j];
            }
        }
        return t;

    }
}